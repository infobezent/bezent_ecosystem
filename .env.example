# ==============================================================================
# BEZENT — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Application ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4000

# --- Web (apps/web) ---
# Base URL the frontend uses to reach the API.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- MySQL (apps/api / Drizzle) ---
# Individual connection parameters (used to build the pool config).
DB_HOST=localhost
DB_PORT=3306
DB_USER=bezent
DB_PASSWORD=
DB_NAME=bezent_dev

# Alternatively, a single connection URL may be used instead of the
# individual DB_* variables above:
# DATABASE_URL=mysql://user:password@localhost:3306/bezent_dev

# --- Authentication: Email OTP (ADR-018) ---
# Long random secret used to digest OTP codes. REQUIRED in production (32+ chars).
OTP_SECRET=

# Public URL of the web app, linked from sign-in invitation emails.
WEB_APP_URL=http://localhost:3000

# --- Email delivery (ADR-018) ---
# 'outbox' stores emails in the local email_outbox table (development/tests only).
# Production requires 'smtp' and refuses to start otherwise.
EMAIL_TRANSPORT=outbox
MAIL_FROM=BEZENT <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
